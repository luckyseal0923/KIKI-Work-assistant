# 複製為 .env，僅在本機安全編輯；Coolify 請用受保護的 runtime variables。
APP_MODE=discover
PORT=3000
LINE_CHANNEL_SECRET=
# record 模式必填，作為原管理群；多群功能關閉時只允許這一群。
ALLOWED_GROUP_ID=

# 以下僅在 record 模式需要；管理網頁網址不是 PostgreSQL 主機位址。
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=linebot_app
DB_PASSWORD=
# verify-full：驗證 TLS 憑證與主機名稱；自簽 CA 請掛載唯讀檔案。
DB_TLS=verify-full
DB_CA_FILE=
# 只有經確認的同主機私有容器網路才可改 DB_TLS=private 並設為 true。
DB_PRIVATE_NETWORK_CONFIRMED=false

# 僅供 compose.yaml 的部署設定；不是資料庫密碼，填實際已存在的 Supabase stack 網路名稱。
# 只用 Dockerfile 做 discover 時可留空；Compose 部署時必填。
SUPABASE_DOCKER_NETWORK=

# 第二階段：只接受既定管理者的真正 @KIKI；完成 003 與設定驗證後才啟用。
ASSISTANT_ENABLED=false
# 自然語言提問／草擬：完成 004 並通過稽核後才開啟；沿用同一每日 AI 請求額度。
ASSISTANT_FREEFORM_ENABLED=false
# 對話記憶＋工作提案：完成 005 與稽核後才開啟；須同時啟用上面兩旗標。
ASSISTANT_WORKSPACE_ENABLED=false
# 卡片按鈕、清楚錯誤提示與主題別名：完成 006 與稽核後才開啟。
ASSISTANT_ORGANIZER_ENABLED=false
# 多群須先完成 006；既定管理者在新群申請並確認，所有群共用 AI 額度。
ASSISTANT_MULTI_GROUP_ENABLED=false
ASSISTANT_MAX_GROUPS=3
# 工作秘書模式每次送模型的精選來源與總文字上限；資料庫仍保存原訊息。
ASSISTANT_CONTEXT_MESSAGES=20
ASSISTANT_CONTEXT_CHARACTERS=12000
# 必須是 LINE 的 U 開頭 user ID，不是顯示名稱或 LINE ID；不得自動認領第一個來訊者。
OPERATOR_USER_ID=
# 以下兩個是新秘密；由本人填入受保護 Runtime、Literal 開啟、Buildtime 關閉。
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ASSISTANT_MAX_MESSAGES=100
ASSISTANT_DAILY_LIMIT=20
ASSISTANT_COOLDOWN_SECONDS=30
