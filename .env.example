# 複製為 .env，僅在本機安全編輯；Coolify 請用受保護的 runtime variables。
APP_MODE=discover
PORT=3000
LINE_CHANNEL_SECRET=
# record 模式必填，恰好一個群組；discover 不保存任何聊天內容。
ALLOWED_GROUP_ID=

# 以下僅在 record 模式需要；管理網頁網址不是 PostgreSQL 主機位址。
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=linebot_app
DB_PASSWORD=
# verify-full：驗證 TLS 憑證與主機名稱；自簽 CA 請掛載唯讀檔案。
DB_TLS=verify-full
DB_CA_FILE=
# 只有經確認的同主機私有容器網路才可改 DB_TLS=private 並設為 true。
DB_PRIVATE_NETWORK_CONFIRMED=false

# 僅供 compose.yaml 的部署設定；不是資料庫密碼，填實際已存在的 Supabase stack 網路名稱。
# 只用 Dockerfile 做 discover 時可留空；Compose 部署時必填。
SUPABASE_DOCKER_NETWORK=

# 第二階段：只接受既定管理者的真正 @KIKI；完成 003 與設定驗證後才啟用。
ASSISTANT_ENABLED=false
# 必須是 LINE 的 U 開頭 user ID，不是顯示名稱或 LINE ID；不得自動認領第一個來訊者。
OPERATOR_USER_ID=
# 以下兩個是新秘密；由本人填入受保護 Runtime、Literal 開啟、Buildtime 關閉。
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ASSISTANT_MAX_MESSAGES=100
ASSISTANT_DAILY_LIMIT=20
ASSISTANT_COOLDOWN_SECONDS=30
