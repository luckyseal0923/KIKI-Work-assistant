# 複製為 .env，僅在本機安全編輯；Coolify 請用受保護的 runtime variables。
APP_MODE=discover
PORT=3000
LINE_CHANNEL_SECRET=
# record 模式必填，恰好一個群組；discover 不保存任何聊天內容。
ALLOWED_GROUP_ID=

# 以下僅在 record 模式需要；管理網頁網址不是 PostgreSQL 主機位址。
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=linebot_app
DB_PASSWORD=
# verify-full：驗證 TLS 憑證與主機名稱；自簽 CA 請掛載唯讀檔案。
DB_TLS=verify-full
DB_CA_FILE=
# 只有經確認的同主機私有容器網路才可改 DB_TLS=private 並設為 true。
DB_PRIVATE_NETWORK_CONFIRMED=false
